LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
MAX_ARTICLES_PER_RUN=3

# Qwen-compatible DashScope endpoint. Leave blank for deterministic local demo.
QWEN_API_KEY=
QWEN_MODEL=qwen-plus
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1/chat/completions
QWEN_TIMEOUT_SECONDS=30
QWEN_MAX_RETRIES=2

# SMTP is optional. Without credentials, the pipeline writes a preview only.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
SMTP_STARTTLS=true
EMAIL_PREVIEW_ONLY=true

DIGEST_SIZE=10

# Actual digest uses a rolling 48-hour publication window.
LOOKBACK_HOURS=48
PREFERRED_CATEGORIES=technology,science,politics
REQUEST_INTERVAL_SECONDS=4
SMTP_SSL=false

# Vercel cloud deployment. Add these in Vercel Project Settings, never to Git.
# DATABASE_URL is supplied by a PostgreSQL provider such as Neon.
DATABASE_URL=
# Generate distinct random values of at least 32 characters.
CRON_SECRET=
ADMIN_SECRET=
# Example: https://anti-filter-bubble.vercel.app
PUBLIC_BASE_URL=
